# cp .env.example .env して値を入れる（ローカル用）。Cloud Run では Secret Manager と deploy ワークフローが渡す。
POSTGRES_PASSWORD=change-me
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost
PF_INTERNAL_TOKEN=      # openssl rand -hex 24（web→agent-api の内部トークン）
PF_ALLOW_SIGNUP=true    # 社内展開時は false にして招待制へ
# LLM: GOOGLE_API_KEY を入れると Gemini、空ならスタブ（ダミー成果物）で全工程が回る
GOOGLE_API_KEY=
PF_MODEL=gemini-2.5-flash
PF_LLM=
